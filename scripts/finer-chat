#!/usr/bin/env python3
"""Plain streaming chat to finer mlx-dspark. No OpenCode, no extra system prompt."""
import json, os, sys, urllib.request

KEY = open(os.path.expanduser("~/.config/finer/api-key")).read().strip()
URL = os.environ.get("FINER_URL", "http://finer.local:8000/v1/chat/completions")
MODEL = os.environ.get("FINER_MODEL", "Qwen3.8-27B-Abliterated-MLX-MXFP4")

args = [a for a in sys.argv[1:] if a != "--think"]
show_think = "--think" in sys.argv[1:]

msgs = []
if args:
    msgs.append({"role": "system", "content": " ".join(args)})

print("finer — Qwen3.8-27B 4-bit (mlx-dspark). Empty line or Ctrl-C to quit.")
if not args:
    print("no system prompt. pass one as args if you want.\n")
else:
    print("system:", " ".join(args), "\n")

while True:
    try:
        user = input("\033[1;36myou>\033[0m ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        break
    if not user:
        break
    msgs.append({"role": "user", "content": user})
    payload = {
        "model": MODEL,
        "messages": msgs,
        "stream": True,
        "max_tokens": 65536,
    }
    req = urllib.request.Request(
        URL,
        data=json.dumps(payload).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": "Bearer " + KEY,
        },
    )
    acc = []
    in_reasoning = False
    started = False
    try:
        with urllib.request.urlopen(req) as r:
            while True:
                raw = r.readline()
                if not raw:
                    break
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                body = line[5:].strip()
                if body == "[DONE]":
                    break
                try:
                    delta = json.loads(body)["choices"][0].get("delta") or {}
                except Exception:
                    continue
                think = delta.get("reasoning_content") or ""
                if think and not show_think:
                    if not in_reasoning:
                        print("\033[2;37mthinking\033[0m", end="", flush=True)
                        in_reasoning = True
                    print("\033[2;37m.\033[0m", end="", flush=True)
                elif think:
                    if not in_reasoning:
                        print("\033[2;37m", end="", flush=True)
                        in_reasoning = True
                    print(think, end="", flush=True)
                text = delta.get("content") or ""
                if text:
                    if in_reasoning:
                        print("\033[0m\n", end="", flush=True)
                        in_reasoning = False
                    if not started:
                        print("\033[1;32mai>\033[0m ", end="", flush=True)
                        started = True
                    acc.append(text)
                    print(text, end="", flush=True)
    except KeyboardInterrupt:
        print("\n[interrupted]")
    except Exception as e:
        print(f"\n[error] {e}")
    if in_reasoning:
        print("\033[0m", end="")
    print("\n")
    msgs.append({"role": "assistant", "content": "".join(acc)})
